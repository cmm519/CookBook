# Copy to .env or run CookBook-Setup.bat to generate automatically

MODE=web

# Host bind-mount paths (Windows: use forward slashes, e.g. C:/Users/you/CookBook/db)
HOST_DB_DIR=./data/db
HOST_OLLAMA_DIR=./data/ollama
HOST_DATASET_DIR=./dataset
HOST_RECIPES_DIR=./recipes
HOST_WORKING_DIR=./working
HOST_WHISPER_CACHE_DIR=./data/whisper-cache

# Container paths (inside Docker — do not change unless you know why)
REPOSITORY_PATH=/data/recipes
WORKING_DIR=/data/working
DATABASE_PATH=/data/db/recipes.db
DATASET_DIR=/data/dataset
DATASET_RAW_DIR=/data/dataset/raw
DATASET_MANIFEST_PATH=/data/dataset/manifest.json
DATASET_METADATA_DIR=/data/dataset/metadata
DATASET_URLS_FILE=/data/dataset/urls.txt

DOWNLOAD_SOURCE_URL=
DOWNLOAD_LIMIT=50

# Whisper: cuda (GPU) or cpu
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# Ollama formatter (interim model — distillation on hold; see cursor1/DOCKER.md)
FORMATTER_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
FORMATTER_MODEL=qwen2.5:7b-instruct

FRAME_INTERVAL=1
KEEP_WORKING=false
VIDEO_PROCESSING_DEFAULT=true

WEB_PORT=8080
TESTING_GUI_PORT=8081
DEPLOYMENT_GUI_PORT=8082

# Instagram auth (optional)
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=/data/dataset/cookies.txt
